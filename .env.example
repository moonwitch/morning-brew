# MorningBrew — environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
#
# Bun auto-loads `.env`; do not add dotenv.

# ---------------------------------------------------------------------------
# Monday.com source plugin
# ---------------------------------------------------------------------------
# Personal API token: monday.com > avatar > Developers > My access tokens.
# Treat as a password — it carries your full account permissions.
MONDAY_API_TOKEN=

# The board MorningBrew reads tasks from and writes status/parking back to.
MONDAY_BOARD_ID=18425029943

# Column IDs on the board above. Leave blank to let the plugin resolve them by
# title on first run and log what it found.
MONDAY_STATUS_COLUMN_ID=
MONDAY_PARKING_COLUMN_ID=
MONDAY_SIZE_COLUMN_ID=
MONDAY_PRIORITY_COLUMN_ID=
MONDAY_TEAM_VALUE_COLUMN_ID=

# ---------------------------------------------------------------------------
# Core engine
# ---------------------------------------------------------------------------
# Local-only storage for cached tasks and plan state. Keep it outside the repo
# if you sync this directory anywhere.
MORNINGBREW_DATA_DIR=./.morningbrew

# debug | info | warn | error
MORNINGBREW_LOG_LEVEL=info

# Redact task titles and notes from logs. Leave `true` unless actively
# debugging — logs are the easiest place to leak work content.
MORNINGBREW_REDACT_LOGS=true

# Minimum Garrett's Team Value score (0-5) a task must clear to reach the
# day plan. See packages/core/src/filters.ts.
MORNINGBREW_TEAM_VALUE_MIN_SCORE=2
